# Copy to .env for local overrides. Never commit .env.
AGENT_PORT=8765
# Include the service's API prefix (often /v1).
AGENT_MODEL_BASE_URL=
AGENT_MODEL_NAME=
AGENT_MODEL_API_KEY=
# Optional operator prices in USD per one million tokens; no price is assumed.
# AGENT_MODEL_INPUT_USD_PER_MILLION=
# AGENT_MODEL_OUTPUT_USD_PER_MILLION=
# Optional persistent personal API token. Set this to require manual UI login.
AGENT_ACCESS_TOKEN=
# Optional independent credential for server-to-server tools.
AGENT_SERVICE_TOKEN=
# AGENT_SCENARIOS=/absolute/path/to/scenarios
# AGENT_DATABASE=/absolute/path/to/agent.db
# embedded runs the read-only plan worker in the local API process.
# external uses separate processes started with python -m app.worker.
AGENT_PLAN_WORKER=embedded
AGENT_PLAN_LEASE_SECONDS=12

# Optional offline governance. Keep three separate, high-entropy tokens locally.
AGENT_MOCK_WRITES=0
AGENT_REAL_WRITES=0
AGENT_APPROVER_TOKEN=
AGENT_ADMIN_TOKEN=
# AGENT_PRINCIPALS_FILE=/absolute/path/to/principals.json
# AGENT_RELEASE_CANDIDATES=/absolute/path/to/reviewed-candidates
