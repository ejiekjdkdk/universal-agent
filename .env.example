# 复制为 .env 后填写本机配置；凭据只保存在本地。
AGENT_PORT=8765
# 地址包含服务的 API 路径前缀，例如 /v1。
AGENT_MODEL_BASE_URL=
AGENT_MODEL_NAME=
AGENT_MODEL_API_KEY=
# 可选的输入、输出单价，单位为美元/百万 Token；未配置时价格未知。
# AGENT_MODEL_INPUT_USD_PER_MILLION=
# AGENT_MODEL_OUTPUT_USD_PER_MILLION=
# 设置固定的个人访问令牌后，网页需要手工登录。
AGENT_ACCESS_TOKEN=
# 服务间工具调用使用单独的可选凭据。
AGENT_SERVICE_TOKEN=
# AGENT_SCENARIOS=/absolute/path/to/scenarios
# AGENT_DATABASE=/absolute/path/to/agent.db
# 已发布技能与草稿的本地目录；默认位于任务数据库旁的 skills 目录。
# AGENT_SKILL_ROOT=/absolute/path/to/skills
# MCP 端点与租户凭据句柄只来自本机审核的配置文件。
# AGENT_MCP_SERVERS=/absolute/path/to/mcp-servers.json
# 事件来源、签名密钥句柄和定时规则，未配置时不会接收触发。
# AGENT_TRIGGERS_FILE=/absolute/path/to/triggers.json
# 专业 Agent 委派显式启用。
AGENT_SPECIALISTS=0
# V3.1 可选输入编译器；只改变模型输入，不改变旧 API 的完整结果。
AGENT_CONTEXT_COMPILER=0
# V3.1 P2默认关闭；文件仅含密钥环境引用及可信结果/只读缓存策略。
# AGENT_P2_POLICY=C:/private/agent-p2-policy.json
# 在本机环境设置64位随机十六进制密钥，不要把实际密钥写入本文件或仓库。
# AGENT_RESULT_KEY_V1=
# embedded 在 API 进程内调度计划。
# external 使用通过 python -m app.worker 启动的独立进程。
AGENT_PLAN_WORKER=embedded
AGENT_PLAN_LEASE_SECONDS=12

# 可选的本地治理配置：申请人、审批人和管理员分别使用独立的高熵令牌。
AGENT_MOCK_WRITES=0
AGENT_REAL_WRITES=0
AGENT_APPROVER_TOKEN=
AGENT_ADMIN_TOKEN=
# AGENT_PRINCIPALS_FILE=/absolute/path/to/principals.json
# AGENT_RELEASE_CANDIDATES=/absolute/path/to/reviewed-candidates
