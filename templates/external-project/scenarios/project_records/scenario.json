{
  "id": "project_records",
  "version": "1.0.1",
  "name": "项目记录查询",
  "description": "读取独立项目 API 中的一条记录，并核对来源和版本。",
  "example": "请查询 DOC-101 的状态",
  "offline_tool": "lookup_record",
  "tools": [
    {
      "name": "lookup_record",
      "description": "按 DOC 编号到当前项目读取记录状态，例如 DOC-101。",
      "permission": "records.read",
      "action_level": "read",
      "input_schema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          }
        },
        "required": [
          "summary"
        ],
        "additionalProperties": false
      },
      "adapter": {
        "type": "python",
        "handler": "lookup"
      }
    }
  ]
}
