{
  "version": "1.0.1",
  "tools": [
    {
      "name": "notes_search",
      "description": "按文本匹配本场景笔记，并返回带版本的原文。",
      "permission": "notes.read",
      "action_level": "read",
      "input_schema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "matches": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "summary",
          "matches"
        ],
        "additionalProperties": false
      },
      "adapter": {
        "type": "python",
        "handler": "search"
      }
    }
  ],
  "id": "notes",
  "name": "资料问答",
  "description": "在当前场景的示例笔记中查找原文，返回可核对的片段和版本。",
  "example": "查找会议纪要的记录要求",
  "offline_tool": "notes_search",
  "documents": "notes.json"
}
